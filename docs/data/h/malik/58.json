{"1841":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","يحيى بن سعيد"],["t","أبي الحباب"]]],"1842":[[["سليم الهلالي","صحيح"]],[["t","إسحاق بن عبد الله بن أبي طلحة"],["t","ما قلت فيه وإني أرى أن تجعلها في الأقربين ‏\"‏ ‏.‏ فقال أبو طلحة أفعل يا رسول الله فقسمها أبو طلحة في أقاربه وبني عمه ‏.‏"]]],"1843":[[["سليم الهلالي","ضعيف"]],[["t","زيد بن أسلم"]]],"1844":[[["سليم الهلالي","لغيره حسن"]],[["t","زيد بن أسلم"],["t","عمرو بن معاذ الأشهلي الأنصاري"]]],"1845":[[["سليم الهلالي","موقوف ضعيف"]],[["t","مالك"],["t","عائشة"]]],"1846":[[["سليم الهلالي","موقوف ضعيف"]],[["t","مالك"]]],"1847":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","ابن شهاب"],["t","عطاء بن يزيد الليثي"],["t","أبي سعيد الخدري"]]],"1848":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","نافع"],["t","عبد الله بن عمر"],["t","المسألة - ‏ \"‏ اليد العليا خير من اليد السفلى واليد العليا هي المنفقة والسفلى هي السائلة ‏\"‏ ‏.‏"]]],"1849":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","زيد بن أسلم"],["t","عطاء بن يسار"],["t","المسألة فأما ما كان من غير مسألة فإنما هو رزق يرزقكه الله ‏\"‏ ‏.‏ فقال عمر بن الخطاب أما والذي نفسي بيده لا أسأل أحدا شيئا ولا يأتيني شىء من غير مسألة إلا أخذته ‏.‏"]]],"1850":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","أبي الزناد"],["t","الأعرج"],["t","أبي هريرة"]]],"1851":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","زيد بن أسلم"],["t","عطاء بن يسار"],["t","رجل"]]],"1852":[[["سليم الهلالي","صحيح"]],[["t","العلاء بن عبد الرحمن"]]],"1853":[[["سليم الهلالي","صحيح"]],[["t","مالك"]]],"1854":[[["سليم الهلالي","ضعيف"]],[["t","مالك"],["t","عبد الله بن أبي بكر"]]],"1855":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","زيد بن أسلم"]]]}