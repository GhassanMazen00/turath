{"1272":[[["سليم الهلالي","صحيح"]],[["t","يحيى"],["t","مالك"],["t","عبد الله بن أبي بكر"],["t","عمرة بنت عبد الرحمن"],["t","صوت رجل يستأذن في بيت حفصة قالت عائشة فقلت يا رسول الله هذا رجل يستأذن في بيتك ‏.‏ فقال رسول الله"]]],"1273":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","هشام بن عروة"],["t","عروة بن الزبير"],["t","عائشة أم المؤمنين"],["t","ذلك فجاء رسول الله"],["t","ذلك فقال ‏\"‏ إنه عمك فأذني له ‏\"‏ ‏.‏ قالت فقلت يا رسول الله إنما أرضعتني المرأة ولم يرضعني الرجل ‏.‏ فقال ‏\"‏ إنه عمك فليلج عليك ‏\"‏ ‏.‏ قالت عائشة وذلك بعد ما ضرب علينا الحجاب ‏.‏ وقالت عائشة يحرم من الرضاعة ما يحرم من الولادة ‏.‏"]]],"1274":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","ابن شهاب"],["t","عروة بن الزبير"],["t","عائشة أم المؤمنين"]]],"1275":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","ثور بن زيد الديلي"],["t","عبد الله بن عباس"]]],"1276":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","ابن شهاب"],["t","عمرو بن الشريد"],["t","رجل"]]],"1277":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","نافع"]]],"1278":[[["سليم الهلالي","موقوف ضعيف"]],[["t","مالك"],["t","نافع"]]],"1279":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","نافع"]]],"1280":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","عبد الرحمن بن القاسم"]]],"1281":[[["سليم الهلالي","مقطوع صحيح"]],[["t","مالك"],["t","إبراهيم بن عقبة"],["t","الرضاعة"]]],"1282":[[["سليم الهلالي","مقطوع صحيح"]],[["t","مالك"],["t","يحيى بن سعيد"],["t","سعيد بن المسيب"]]],"1283":[[["سليم الهلالي","مقطوع صحيح"]],[["t","مالك"],["t","ابن شهاب"]]],"1284":[[["سليم الهلالي","حسن"]],[["t","يحيى"],["t","مالك"],["t","ابن شهاب"],["t","رضاعة الكبير"]]],"1285":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","عبد الله بن دينار"],["t","رضاعة الكبير فقال عبد الله بن عمر جاء رجل إلى عمر بن الخطاب فقال إني كانت لي وليدة وكنت أطؤها فعمدت امرأتي إليها فأرضعتها فدخلت عليها فقالت دونك فقد والله أرضعتها ‏.‏ فقال عمر أوجعها وأت جاريتك فإنما الرضاعة رضاعة الصغير ‏.‏"]]],"1286":[[["سليم الهلالي","موقوف صحيح"]],[["t","مالك"],["t","يحيى بن سعيد"],["t","امرأتي"],["t","شىء ما كان هذا الحبر بين أظهركم ‏.‏"]]],"1287":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","عبد الله بن دينار"],["t","سليمان بن يسار"],["t","عروة بن الزبير"],["t","عائشة أم المؤمنين"]]],"1288":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","محمد بن عبد الرحمن بن نوفل"],["t","عائشة أم المؤمنين"],["t","جدامة بنت وهب الأسدية"],["t","رسول الله"],["t","الغيلة حتى ذكرت أن الروم وفارس يصنعون ذلك فلا يضر أولادهم ‏\"‏ ‏.‏"]]],"1289":[[["سليم الهلالي","صحيح"]],[["t","مالك"],["t","عبد الله بن أبي بكر بن حزم"],["t","عمرة بنت عبد الرحمن"],["t","عائشة"]]]}